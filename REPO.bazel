"Repository-level settings for the OpenBSW Bazel module."

# Exclude vendored third-party module tests from wildcard builds and queries
# (e.g. bazel build/test/query //...).
ignore_directories([
    "libs/3rdparty/etl/test",
    "libs/3rdparty/googletest/googletest/test",
    "libs/3rdparty/googletest/googlemock/test",
])
