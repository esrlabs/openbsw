:$label="clang-tidy POSIX"
:#image[:+ws/dev-image]
:$output="none"

env = :[
    :$BUILD_DIRECTORY="build/tests/posix/Release"
]

inputs = :[
    :#clang-tidy-build[
        :+ws/clang-tidy
        :$label="clang-tidy POSIX build"

        worktree = :[
            source = ::platforms/posix/
        ]

        env = :[
            :$PRESET="tests-posix-release"
            :$BUILD_DIRECTORY="build/tests/posix/Release"
        ]
    ]
]

worktree = :[
    source = :[
        :+ws/clang-tidy-source
        ::platforms/posix/
    ]
    :/ws::run.sh=clang-tidy.run.sh
]
