#   Default:  referenceApp/unitTest ETL profile (not propagated to downstream consumers)
#   Override: --//libs/3rdparty/etl:etl_profile=//path/to:your_etl_profile
alias(
    name = "etl_profile",
    actual = select(
        {
            "//bazel/config/executable_config:reference_app": "//executables/referenceApp/etl_profile",
            "//bazel/config/executable_config:unit_test": "//executables/unitTest/etl_profile",
        },
        no_match_error = "executable_config must be 'reference_app' or 'unit_test' to select an ETL profile.",
    ),
    visibility = ["//visibility:public"],
)
